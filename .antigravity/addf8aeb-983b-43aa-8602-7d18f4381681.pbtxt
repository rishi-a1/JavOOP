  view_file {
    absolute_path_uri: "file:///src/components/ASLVideoCanvas.tsx"
    start_line: 415
    end_line: 449
    content: "\nfunction drawRealisticSigner(\n  ctx: CanvasRenderingContext2D,\n  width: number,\n  height: number,\n  timeMs: number,\n  activeGloss: GlossToken,\n  isPlaying: boolean\n) {\n  const cx = width * 0.5;\n  const cy = height * 0.44;\n\n  // Signer natural weight-shift and engagement\n  const sway = isPlaying ? Math.sin(timeMs * 0.0016) * 5 : 0;\n  const breath = isPlaying ? Math.cos(timeMs * 0.0022) * 2.5 : 0;\n\n  // Head tilt & turn corresponding to active ASL Non-Manual Marker\n  let headTiltX = 0;\n  let headTiltY = 0;\n  if (activeGloss.nmm.head === \'tilt-left\') headTiltX = -5;\n  if (activeGloss.nmm.head === \'tilt-right\') headTiltX = 5;\n  if (activeGloss.nmm.head === \'nod\') headTiltY = Math.sin(timeMs * 0.008) * 4;\n  if (activeGloss.nmm.head === \'forward\') headTiltY = 4;\n\n  ctx.save();\n\n  // 1. Torso: High-contrast charcoal pullover (Industry standard for ASL interpreters & professional deaf speakers)\n  ctx.fillStyle = \'#172033\';\n  ctx.beginPath();\n  ctx.moveTo(cx - 180 + sway, height);\n  ctx.lineTo(cx - 145 + sway, cy + 140 + breath);\n  // Left shoulder contour\n  ctx.bezierCurveTo(cx - 140, cy + 90, cx - 85, cy + 65, cx - 45, cy + 72);\n  // Neck base\n  ctx.lineTo(cx - 28, cy + 38);"
    num_lines: 1025
    num_bytes: 33175
  }
}
