    content: "export interface GlossToken {\n  timeMs: number;\n  token: string;\n  meaning: string;\n  confidence: number;\n}\n\nexport interface QuestionData {\n  id: number;\n  numberText: string;\n  question: string;\n  context: string;\n  suggestedDurationSec: number;\n  glossSequence: GlossToken[];\n  sampleEnglishTranscript: string;\n  aiJudgmentNote: string;\n  competencyHighlights: string[];\n  sampleGestures: {\n    startMs: number;\n    endMs: number;\n    primaryHand: \'left\' | \'right\' | \'both\';\n    handshape: \'open5\' | \'fist\' | \'pointing\' | \'flatB\' | \'vShape\';\n    motion: \'chestSweep\' | \'forwardPush\' | \'circular\' | \'horizontalWave\' | \'nodding\';\n  }[];\n}\n\nexport interface CompetencyScore {\n  name: string;\n  score: number; // out of 10\n  maxScore: number;\n  justification: string;\n  trend: string;\n}\n\nexport interface CandidateProfile {\n  name: string;\n  role: string;\n  experience: string;\n  matchScore: number;\n  recommendation: \'Strong Hire\' | \'Hire\' | \'Review\';\n  accessibilityVerified: boolean;\n  avatarSeed: string;\n}\n"
