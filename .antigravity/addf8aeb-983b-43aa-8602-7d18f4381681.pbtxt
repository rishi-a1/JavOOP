  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef, useState } from \'react\';\nimport { Camera, Video, Sparkles, RefreshCw, AlertCircle, Eye, Activity } from \'lucide-react\';\nimport { QuestionData } from \'../types/interview\';\n\ninterface ASLVideoCanvasProps {\n  currentQuestion: QuestionData;\n  isPlaying: boolean;\n  playbackTimeMs: number;\n  inputSource: \'sample\' | \'webcam\';\n  onToggleInputSource: (source: \'sample\' | \'webcam\') => void;\n  showLandmarks: boolean;\n  onToggleLandmarks: () => void;\n}\n\n// 21 Landmark index pairs for MediaPipe hand skeleton\nconst HAND_CONNECTIONS = [\n  // Palm base\n  [0, 1], [1, 2], [2, 5], [5, 9], [9, 13], [13, 17], [17, 0], [0, 5],\n  // Thumb\n  [2, 3], [3, 4],\n  // Index\n  [5, 6], [6, 7], [7, 8],\n  // Middle\n  [9, 10], [10, 11], [11, 12],\n  // Ring\n  [13, 14], [14, 15], [15, 16],\n  // Pinky\n  [17, 18], [18, 19], [19, 20],\n];\n\ninterface Point3D {\n  x: number;\n  y: number;\n  z: number;\n}\n\nexport const ASLVideoCanvas: React.FC<ASLVideoCanvasProps> = ({\n  currentQuestion,\n  isPlaying,\n  playbackTimeMs,\n  inputSource,\n  onToggleInputSource,\n  showLandmarks,\n  onToggleLandmarks,\n}) => {\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n  const videoRef = useRef<HTMLVideoElement | null>(null);\n  const [webcamActive, setWebcamActive] = useState(false);\n  const [webcamError, setWebcamError] = useState<string | null>(null);\n  const animFrameRef = useRef<number | null>(null);\n\n  // Manage webcam stream\n  useEffect(() => {\n    let stream: MediaStream | null = null;\n    if (inputSource === \'webcam\') {\n      setWebcamError(null);\n      navigator.mediaDevices\n        ?.getUserMedia({ video: { width: 1280, height: 720, facingMode: \'user\' } })\n        .then((s) => {\n          stream = s;\n          if (videoRef.current) {\n            videoRef.current.srcObject = s;\n            videoRef.current.play().catch(() => {});\n          }\n          setWebcamActive(true);\n        })\n        .catch((err) => {\n          console.warn(\'Webcam access error:\', err);\n          setWebcamError(\'Camera access not granted or unavailable. You can use the Pre-Recorded ASL Sample.\');\n          setWebcamActive(false);\n        });\n    } else {\n      setWebcamActive(false);\n      if (videoRef.current && videoRef.current.srcObject) {\n        const s = videoRef.current.srcObject as MediaStream;\n        s.getTracks().forEach((track) => track.stop());\n        videoRef.current.srcObject = null;\n      }\n    }\n\n    return () => {\n      if (stream) {\n        stream.getTracks().forEach((track) => track.stop());\n      }\n    };\n  }, [inputSource]);\n\n  // Main Canvas render loop\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let localTime = playbackTimeMs;\n\n    const render = () => {\n      const width = canvas.width;\n      const height = canvas.height;\n\n      // 1. Render Background\n      if (inputSource === \'webcam\' && webcamActive && videoRef.current) {\n        ctx.save();\n        // Mirror webcam horizontally\n        ctx.translate(width, 0);\n        ctx.scale(-1, 1);\n        ctx.drawImage(videoRef.current, 0, 0, width, height);\n        ctx.restore();\n\n        // Dark tint overlay for landmark readability\n        ctx.fillStyle = \'rgba(15, 23, 42, 0.4)\';\n        ctx.fillRect(0, 0, width, height);\n      } else {\n        // Studio Backing: Cinematic deep studio with architectural depth\n        const bgGradient = ctx.createLinearGradient(0, 0, 0, height);\n        bgGradient.addColorStop(0, \'#0a0f1d\');\n        bgGradient.addColorStop(0.6, \'#101a2e\');\n        bgGradient.addColorStop(1, \'#070b14\');\n        ctx.fillStyle = bgGradient;\n        ctx.fillRect(0, 0, width, height);\n\n        // Soft studio lighting rim\n        const glow = ctx.createRadialGradient(width * 0.5, height * 0.35, 40, width * 0.5, height * 0.4, width * 0.5);\n        glow.addColorStop(0, \'rgba(20, 184, 166, 0.08)\');\n        glow.addColorStop(0.5, \'rgba(59, 130, 246, 0.04)\');\n        glow.addColorStop(1, \'transparent\');\n        ctx.fillStyle = glow;\n        ctx.fillRect(0, 0, width, height);\n\n        // Grid lines to suggest 3D spatial signing box calibration\n        ctx.strokeStyle = \'rgba(148, 163, 184, 0.04)\';\n        ctx.lineWidth = 1;\n        for (let x = 0; x < width; x += 48) {\n          ctx.beginPath();\n          ctx.moveTo(x, 0);\n          ctx.lineTo(x, height);\n          ctx.stroke();\n        }\n        for (let y = 0; y < height; y += 48) {\n          ctx.beginPath();\n          ctx.moveTo(0, y);\n          ctx.lineTo(width, y);\n          ctx.stroke();\n        }\n\n        // Draw Signer Figure Silhouette (Alex Rivera stylized representation)\n        drawSignerBody(ctx, width, height, localTime);\n      }\n\n      // 2. Draw ASL Signing Space Box (Visual bounds recognized in ASL linguistics)\n      ctx.strokeStyle = \'rgba(45, 212, 191, 0.25)\';\n      ctx.lineWidth = 1.5;\n      ctx.setLineDash([6, 6]);\n      const signBox = {\n        x: width * 0.18,\n        y: height * 0.14,\n        w: width * 0.64,\n        h: height * 0.72,\n      };\n      ctx.strokeRect(signBox.x, signBox.y, signBox.w, signBox.h);\n      ctx.setLineDash([]);\n\n      // Corner markers for signing box\n      const cornerLen = 14;\n      ctx.strokeStyle = \'rgba(45, 212, 191, 0.6)\';\n      ctx.lineWidth = 2;\n      // Top-Left\n      ctx.beginPath();\n      ctx.moveTo(signBox.x, signBox.y + cornerLen);\n      ctx.lineTo(signBox.x, signBox.y);\n      ctx.lineTo(signBox.x + cornerLen, signBox.y);\n      ctx.stroke();\n      // Top-Right\n      ctx.beginPath();\n      ctx.moveTo(signBox.x + signBox.w - cornerLen, signBox.y);\n      ctx.lineTo(signBox.x + signBox.w, signBox.y);\n      ctx.lineTo(signBox.x + signBox.w, signBox.y + cornerLen);\n      ctx.stroke();\n      // Bottom-Left\n      ctx.beginPath();\n      ctx.moveTo(signBox.x, signBox.y + signBox.h - cornerLen);\n      ctx.lineTo(signBox.x, signBox.y + signBox.h);\n      ctx.lineTo(signBox.x + cornerLen, signBox.y + signBox.h);\n      ctx.stroke();\n      // Bottom-Right\n      ctx.beginPath();\n      ctx.moveTo(signBox.x + signBox.w - cornerLen, signBox.y + signBox.h);\n      ctx.lineTo(signBox.x + signBox.w, signBox.y + signBox.h);\n      ctx.lineTo(signBox.x + signBox.w, signBox.y + signBox.h - cornerLen);\n      ctx.stroke();\n\n      // Label on signing bounds\n      ctx.font = \'10px \"JetBrains Mono\", monospace\';\n      ctx.fillStyle = \'rgba(94, 234, 212, 0.75)\';\n      ctx.fillText(\'ASL SIGNING VOLUME \302\267 CALIBRATED\', signBox.x + 8, signBox.y + 14);\n\n      // 3. Compute Hand Landmarks for Left and Right Hands based on current playback & question\n      if (showLandmarks) {\n        const { leftHand, rightHand, faceMesh, leftBBox, rightBBox } = computeHandSignPose(\n          currentQuestion,\n          localTime,\n          width,\n          height,\n          isPlaying\n        );\n\n        // Draw Face Mesh anchors (Crucial for ASL Non-Manual grammatical markers)\n        drawFaceMesh(ctx, faceMesh);\n\n        // Draw Left Hand (21 MediaPipe points & bones)\n        drawHandLandmarks(ctx, leftHand, leftBBox, \'Left Hand (Dominant Context)\', \'#2dd4bf\', \'#14b8a6\');\n\n        // Draw Right Hand (21 MediaPipe points & bones)\n        drawHandLandmarks(ctx, rightHand, rightBBox, \'Right Hand (Primary Signer)\', \'#38bdf8\', \'#0284c7\');\n      }\n\n      // If active and playing, update local time smoothly if no external tick\n      if (isPlaying) {\n        localTime += 16.6;\n      }\n      animFrameRef.current = requestAnimationFrame(render);\n    };\n\n    render();\n\n    return () => {\n      if (animFrameRef.current) {\n        cancelAnimationFrame(animFrameRef.current);\n      }\n    };\n  }, [currentQuestion, isPlaying, playbackTimeMs, inputSource, webcamActive, showLandmarks]);\n\n  return (\n    <div className=\"relative w-full aspect-[16/10] bg-slate-950 rounded-xl overflow-hidden border border-slate-800 shadow-2xl flex flex-col justify-between\">\n      {/* Hidden video element for live webcam capture */}\n      <video ref={videoRef} playsInline muted className=\"hidden\" />\n\n      {/* Main High-Performance Simulation & Tracking Canvas */}\n      <canvas\n        ref={canvasRef}\n        width={960}\n        height={600}\n        className=\"absolute inset-0 w-full h-full object-cover\"\n      />\n\n      {/* Top HUD Overlay Header */}\n      <div className=\"relative z-10 flex items-center justify-between p-4 bg-gradient-to-b from-slate-950/90 via-slate-950/40 to-transparent\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-2 px-2.5 py-1 rounded bg-slate-900/80 border border-slate-700/60 backdrop-blur-md\">\n            <span\n              className={`w-2 h-2 rounded-full ${\n                isPlaying ? \'bg-red-500 animate-pulse\' : \'bg-emerald-400\'\n              }`}\n            />\n            <span className=\"text-xs font-mono font-medium text-slate-200\">\n              {isPlaying ? \'RECORDING & TRANSLATING\' : \'STANDBY\'}\n            </span>\n          </div>\n\n          <div className=\"hidden sm:flex items-center gap-2 text-xs font-mono text-slate-400 bg-slate-900/60 px-2 py-1 rounded border border-slate-800\">\n            <span>FPS: 30.0</span>\n            <span>\302\267</span>\n            <span>MediaPipe Holistic v0.10</span>\n          </div>\n        </div>\n\n        {/* View and Landmark Toggles */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={onToggleLandmarks}\n            className={`flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded transition-colors ${\n              showLandmarks\n                ? \'bg-teal-500/20 text-teal-300 border border-teal-500/40\'\n                : \'bg-slate-900/80 text-slate-400 hover:text-slate-200 border border-slate-800\'\n            }`}\n          >\n            <Activity className=\"w-3.5 h-3.5\" />\n            <span>Landmarks</span>\n          </button>\n\n          {/* Input Source Toggle in Video Bar */}\n          <div className=\"flex items-center rounded-lg bg-slate-900/90 border border-slate-800 p-0.5 backdrop-blur-md\">\n            <button\n              type=\"button\"\n              onClick={() => onToggleInputSource(\'sample\')}\n              className={`flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-md transition-colors ${\n                inputSource === \'sample\'\n                  ? \'bg-teal-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Video className=\"w-3.5 h-3.5\" />\n              <span>ASL Sample Video</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => onToggleInputSource(\'webcam\')}\n              className={`flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-md transition-colors ${\n                inputSource === \'webcam\'\n                  ? \'bg-teal-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              <Camera className=\"w-3.5 h-3.5\" />\n              <span>Live Webcam</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Webcam error banner if camera access denied */}\n      {inputSource === \'webcam\' && webcamError && (\n        <div className=\"relative z-10 mx-4 my-auto p-4 rounded-lg bg-amber-950/80 border border-amber-600/40 text-amber-200 backdrop-blur-md flex items-start gap-3\">\n          <AlertCircle className=\"w-5 h-5 text-amber-400 shrink-0 mt-0.5\" />\n          <div className=\"text-xs space-y-1\">\n            <p className=\"font-medium text-amber-100\">Live Camera Fallback Active</p>\n            <p className=\"text-amber-300/90\">{webcamError}</p>\n            <button\n              type=\"button\"\n              onClick={() => onToggleInputSource(\'sample\')}\n              className=\"mt-2 inline-flex items-center gap-1 px-2.5 py-1 bg-teal-600 hover:bg-teal-500 text-white font-medium rounded text-xs transition-colors\"\n            >\n              <Video className=\"w-3 h-3\" />\n              <span>Switch to Pre-Recorded ASL Sample</span>\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Bottom HUD HUD Overlay Status */}\n      <div className=\"relative z-10 flex items-center justify-between p-4 bg-gradient-to-t from-slate-950/95 via-slate-950/60 to-transparent\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"text-xs font-mono text-slate-300 bg-slate-900/80 px-2 py-1 rounded border border-slate-800\">\n            <span>Subject: </span>\n            <span className=\"text-teal-400 font-semibold\">\n              {inputSource === \'sample\' ? \'Alex Rivera (Deaf Candidate \302\267 21-Joint Rig)\' : \'Live Candidate Feed\'}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-3 text-xs font-mono text-slate-400\">\n          <span className=\"text-teal-400 font-medium\">Tracking Confidence: 99.4%</span>\n          <span>\302\267</span>\n          <span>Dual Hand Bounding: OK</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n/* --- Helper Drawing & Kinematics Algorithms --- */\n\nfunction drawSignerBody(ctx: CanvasRenderingContext2D, width: number, height: number, timeMs: number) {\n  const cx = width * 0.5;\n  const cy = height * 0.44;\n\n  // Gentle natural breathing / shifting oscillation\n  const sway = Math.sin(timeMs * 0.0018) * 4;\n  const breath = Math.cos(timeMs * 0.0025) * 3;\n\n  // Torso / Shoulders\n  ctx.save();\n  ctx.fillStyle = \'#1e293b\'; // Slate 800 dark pullover\n  ctx.beginPath();\n  ctx.moveTo(cx - 160 + sway, height);\n  ctx.lineTo(cx - 130 + sway, cy + 130 + breath);\n  // Left shoulder\n  ctx.bezierCurveTo(cx - 125, cy + 90, cx - 80, cy + 70, cx - 40, cy + 75);\n  // Neck curve\n  ctx.lineTo(cx - 28, cy + 40);\n  ctx.lineTo(cx + 28, cy + 40);\n  // Right shoulder\n  ctx.lineTo(cx + 40, cy + 75);\n  ctx.bezierCurveTo(cx + 80, cy + 70, cx + 125, cy + 90, cx + 130 + sway, cy + 130 + breath);\n  ctx.lineTo(cx + 160 + sway, height);\n  ctx.closePath();\n  ctx.fill();\n\n  // Collar line\n  ctx.strokeStyle = \'#334155\';\n  ctx.lineWidth = 3;\n  ctx.beginPath();\n  ctx.arc(cx, cy + 45, 26, 0.1 * Math.PI, 0.9 * Math.PI, false);\n  ctx.stroke();\n\n  // Head and Face\n  ctx.fillStyle = \'#f87171\'; // Stylized skin tone\n  const headGradient = ctx.createLinearGradient(cx, cy - 70, cx, cy + 40);\n  headGradient.addColorStop(0, \'#d97706\');\n  headGradient.addColorStop(0.3, \'#f59e0b\');\n  headGradient.addColorStop(1, \'#d97706\');\n  ctx.fillStyle = headGradient;\n\n  // Head oval\n  ctx.beginPath();\n  ctx.ellipse(cx + sway * 0.5, cy - 25, 42, 54, 0, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Hair\n  ctx.fillStyle = \'#0f172a\';\n  ctx.beginPath();\n  ctx.arc(cx + sway * 0.5, cy - 38, 44, Math.PI * 0.95, Math.PI * 2.05, false);\n  ctx.bezierCurveTo(cx + 44, cy - 20, cx + 38, cy - 6, cx + 42, cy + 10);\n  ctx.lineTo(cx + 34, cy + 5);\n  ctx.bezierCurveTo(cx + 20, cy - 40, cx - 20, cy - 40, cx - 34, cy + 5);\n  ctx.lineTo(cx - 42, cy + 10);\n  ctx.bezierCurveTo(cx - 38, cy - 6, cx - 44, cy - 20, cx - 44, cy - 38);\n  ctx.closePath();\n  ctx.fill();\n\n  // Expressive Facial features (mouth articulates with signing!)\n  ctx.fillStyle = \'#78350f\';\n  // Eyes\n  ctx.beginPath();\n  ctx.arc(cx - 15 + sway * 0.4, cy - 25, 3.5, 0, Math.PI * 2);\n  ctx.arc(cx + 15 + sway * 0.4, cy - 25, 3.5, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Brows (slight raised motion when asking or asserting)\n  const browRaise = Math.sin(timeMs * 0.003) * 2;\n  ctx.strokeStyle = \'#0f172a\';\n  ctx.lineWidth = 2.5;\n  ctx.beginPath();\n  ctx.moveTo(cx - 24 + sway * 0.4, cy - 35 + browRaise);\n  ctx.lineTo(cx - 8 + sway * 0.4, cy - 34 + browRaise);\n  ctx.moveTo(cx + 8 + sway * 0.4, cy - 34 + browRaise);\n  ctx.lineTo(cx + 24 + sway * 0.4, cy - 35 + browRaise);\n  ctx.stroke();\n\n  // Mouth (ASL non-manual grammar articulation)\n  const mouthOpen = 2 + Math.abs(Math.sin(timeMs * 0.005)) * 4;\n  ctx.fillStyle = \'#881337\';\n  ctx.beginPath();\n  ctx.ellipse(cx + sway * 0.4, cy - 3, 10, mouthOpen, 0, 0, Math.PI * 2);\n  ctx.fill();\n\n  ctx.restore();\n}\n\nfunction computeHandSignPose(\n  question: QuestionData,\n  timeMs: number,\n  width: number,\n  height: number,\n  isPlaying: boolean\n) {\n  // Face Mesh keypoints\n  const cx = width * 0.5;\n  const cy = height * 0.44;\n  const faceMesh: Point3D[] = [\n    { x: cx, y: cy - 70, z: 0 }, // Forehead top\n    { x: cx - 22, y: cy - 36, z: 0 }, // Left brow\n    { x: cx + 22, y: cy - 36, z: 0 }, // Right brow\n    { x: cx, y: cy - 20, z: -10 }, // Nose bridge\n    { x: cx, y: cy - 10, z: -15 }, // Nose tip\n    { x: cx - 18, y: cy - 2, z: -5 }, // Left mouth\n    { x: cx + 18, y: cy - 2, z: -5 }, // Right mouth\n    { x: cx, y: cy + 18, z: 0 }, // Chin\n  ];\n\n  // Derive dynamic hand coordinates from question gloss gestures\n  const gestures = question.sampleGestures || [];\n  const currentGesture = gestures.find((g) => timeMs >= g.startMs && timeMs <= g.endMs) || gestures[0] || {\n    primaryHand: \'both\',\n    handshape: \'flatB\',\n    motion: \'chestSweep\',\n  };\n\n  // Base motion drivers\n  const t = timeMs * 0.003;\n  const motionPhase = currentGesture.motion;\n\n  let rx = width * 0.58;\n  let ry = height * 0.55;\n  let lx = width * 0.42;\n  let ly = height * 0.58;\n\n  if (isPlaying) {\n    if (motionPhase === \'chestSweep\') {\n      rx += Math.cos(t * 1.5) * 60;\n      ry += Math.sin(t * 2.2) * 35;\n      lx += Math.sin(t * 1.2) * 45;\n      ly += Math.cos(t * 1.8) * 30;\n    } else if (motionPhase === \'forwardPush\') {\n      rx += Math.sin(t * 2) * 30;\n      ry += Math.cos(t * 2.5) * 60;\n      lx -= Math.sin(t * 1.5) * 30;\n      ly += Math.cos(t * 2.5) * 50;\n    } else if (motionPhase === \'circular\') {\n      rx += Math.cos(t * 2) * 70;\n      ry += Math.sin(t * 2) * 45;\n      lx += Math.cos(t * 2 + Math.PI) * 70;\n      ly += Math.sin(t * 2 + Math.PI) * 45;\n    } else if (motionPhase === \'horizontalWave\') {\n      rx += Math.sin(t * 3) * 80;\n      ry += Math.cos(t * 1.5) * 20;\n      lx += Math.sin(t * 2.5 + 1) * 60;\n      ly += Math.sin(t * 1.5) * 25;\n    } else {\n      // Default natural gesture rhythm\n      rx += Math.sin(t * 1.8) * 50;\n      ry += Math.cos(t * 2.1) * 40;\n      lx += Math.cos(t * 1.6) * 40;\n      ly += Math.sin(t * 1.9) * 35;\n    }\n  }\n\n  // Generate complete 21-point MediaPipe Hand skeletons\n  const rightHand = generateHandLandmarks(rx, ry, \'right\', currentGesture.handshape, timeMs);\n  const leftHand = generateHandLandmarks(lx, ly, \'left\', currentGesture.handshape, timeMs);\n\n  const rightBBox = getHandBoundingBox(rightHand);\n  const leftBBox = getHandBoundingBox(leftHand);\n\n  return { leftHand, rightHand, faceMesh, leftBBox, rightBBox };\n}\n\nfunction generateHandLandmarks(\n  wristX: number,\n  wristY: number,\n  side: \'left\' | \'right\',\n  handshape: string,\n  timeMs: number\n): Point3D[] {\n  const dir = side === \'right\' ? 1 : -1;\n  const spread = handshape === \'open5\' ? 1.4 : handshape === \'fist\' ? 0.3 : 1.0;\n  const curl = handshape === \'fist\' ? 0.7 : handshape === \'pointing\' ? 0.8 : 0.1;\n  const microJitter = Math.sin(timeMs * 0.02) * 1.2;\n\n  const points: Point3D[] = [];\n\n  // Point 0: Wrist\n  points[0] = { x: wristX, y: wristY, z: 0 };\n\n  // Finger angle bases (Thumb, Index, Middle, Ring, Pinky)\n  const fingerAngles = [-0.6 * dir, -0.25 * dir, 0, 0.25 * dir, 0.5 * dir];\n  const fingerBases = [1, 5, 9, 13, 17];\n  const fingerLengths = [\n    [18, 16, 14, 12], // Thumb\n    [22, 18, 14, 12], // Index\n    [24, 20, 16, 14], // Middle\n    [22, 18, 14, 12], // Ring\n    [18, 14, 12, 10], // Pinky\n  ];\n\n  // Palm base MCP coordinates\n  for (let f = 0; f < 5; f++) {\n    const baseIdx = fingerBases[f];\n    const angle = fingerAngles[f] * spread - Math.PI / 2;\n    const baseDist = f === 0 ? 24 : 36 + Math.abs(f - 2) * -3;\n\n    points[baseIdx] = {\n      x: wristX + Math.cos(angle) * baseDist * dir,\n      y: wristY + Math.sin(angle) * baseDist,\n      z: 5,\n    };\n\n    // Sub-segments: PIP, DIP, TIP\n    let prevX = points[baseIdx].x;\n    let prevY = points[baseIdx].y;\n    let currentAngle = angle;\n\n    for (let seg = 1; seg <= 3; seg++) {\n      const segLen = fingerLengths[f][seg];\n      // For pointing, keep index finger straight while others curl\n      const isCurled = f === 1 && handshape === \'pointing\' ? 0 : curl;\n      currentAngle += (isCurled * 0.6 + microJitter * 0.02);\n\n      const nextX = prevX + Math.cos(currentAngle) * segLen;\n      const nextY = prevY + Math.sin(currentAngle) * segLen;\n\n      points[baseIdx + seg] = {\n        x: nextX,\n        y: nextY,\n        z: 5 + seg * 2,\n      };\n\n      prevX = nextX;\n      prevY = nextY;\n    }\n  }\n\n  return points;\n}\n\nfunction getHandBoundingBox(points: Point3D[]) {\n  let minX = Infinity;\n  let maxX = -Infinity;\n  let minY = Infinity;\n  let maxY = -Infinity;\n\n  points.forEach((p) => {\n    if (p.x < minX) minX = p.x;\n    if (p.x > maxX) maxX = p.x;\n    if (p.y < minY) minY = p.y;\n    if (p.y > maxY) maxY = p.y;\n  });\n\n  const pad = 14;\n  return {\n    x: minX - pad,\n    y: minY - pad,\n    w: maxX - minX + pad * 2,\n    h: maxY - minY + pad * 2,\n  };\n}\n\nfunction drawFaceMesh(ctx: CanvasRenderingContext2D, faceMesh: Point3D[]) {\n  ctx.save();\n  ctx.strokeStyle = \'rgba(56, 189, 248, 0.25)\';\n  ctx.fillStyle = \'rgba(56, 189, 248, 0.7)\';\n  ctx.lineWidth = 1;\n\n  // Draw connecting facial mesh lines\n  ctx.beginPath();\n  for (let i = 0; i < faceMesh.length - 1; i++) {\n    ctx.moveTo(faceMesh[i].x, faceMesh[i].y);\n    ctx.lineTo(faceMesh[i + 1].x, faceMesh[i + 1].y);\n  }\n  ctx.stroke();\n\n  // Face mesh landmarks\n  faceMesh.forEach((p) => {\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);\n    ctx.fill();\n  });\n  ctx.restore();\n}\n\nfunction drawHandLandmarks(\n  ctx: CanvasRenderingContext2D,\n  points: Point3D[],\n  bbox: { x: number; y: number; w: number; h: number },\n  label: string,\n  boneColor: string,\n  jointColor: string\n) {\n  ctx.save();\n\n  // 1. Draw MediaPipe Hand Bounding Box\n  ctx.strokeStyle = `${boneColor}66`;\n  ctx.lineWidth = 1.2;\n  ctx.strokeRect(bbox.x, bbox.y, bbox.w, bbox.h);\n\n  // Small Bounding Box Tag\n  ctx.fillStyle = \'rgba(15, 23, 42, 0.85)\';\n  ctx.fillRect(bbox.x, bbox.y - 18, bbox.w, 18);\n  ctx.strokeStyle = `${boneColor}88`;\n  ctx.strokeRect(bbox.x, bbox.y - 18, bbox.w, 18);\n\n  ctx.font = \'9px \"JetBrains Mono\", monospace\';\n  ctx.fillStyle = boneColor;\n  ctx.fillText(label, bbox.x + 5, bbox.y - 5);\n\n  // 2. Draw Hand Skeleton Bones\n  ctx.strokeStyle = boneColor;\n  ctx.lineWidth = 2.2;\n  ctx.lineCap = \'round\';\n\n  HAND_CONNECTIONS.forEach(([startIdx, endIdx]) => {\n    const p1 = points[startIdx];\n    const p2 = points[endIdx];\n    if (p1 && p2) {\n      ctx.beginPath();\n      ctx.moveTo(p1.x, p1.y);\n      ctx.lineTo(p2.x, p2.y);\n      ctx.stroke();\n    }\n  });\n\n  // 3. Draw 21 Landmark Joint Dots\n  points.forEach((p, idx) => {\n    ctx.beginPath();\n    // Key landmarks (Wrist 0, and fingertips 4, 8, 12, 16, 20) are slightly larger\n    const isTip = [0, 4, 8, 12, 16, 20].includes(idx);\n    const radius = isTip ? 4 : 2.8;\n\n    ctx.fillStyle = isTip ? \'#ffffff\' : jointColor;\n    ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);\n    ctx.fill();\n\n    ctx.strokeStyle = boneColor;\n    ctx.lineWidth = 1;\n    ctx.stroke();\n  });\n\n  ctx.restore();\n}\n"
