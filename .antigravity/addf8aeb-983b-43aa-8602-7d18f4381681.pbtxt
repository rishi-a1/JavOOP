            }
            lines {
              text: "  // 5. Authentic ASL Mouth Morphemes"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // \'cha\' (large open rounded), \'pah!\' (compressed then released), \'cs\' (clenched/tight), \'mm\' (pressed lips), \'firm\'"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const morpheme = activeGloss.nmm.mouthMorpheme;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.save();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
