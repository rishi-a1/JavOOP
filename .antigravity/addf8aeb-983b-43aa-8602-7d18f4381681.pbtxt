  code_action {
    action_spec {
      create_file {
        instruction: "import { QuestionData, CompetencyScore, CandidateProfile } from \'../types/interview\';\n\nexport const CANDIDATE_PROFILE: CandidateProfile = {\n  name: \'Alex Rivera\',\n  role: \'Senior Product Designer\',\n  experience: \'7 years experience \302\267 Universal Design & Systems\',\n  matchScore: 94,\n  recommendation: \'Strong Hire\',\n  accessibilityVerified: true,\n  avatarSeed: \'alex-rivera-designer\',\n};\n\nexport const COMPETENCY_SCORES: CompetencyScore[] = [\n  {\n    name: \'Technical Depth\',\n    score: 9.6,\n    maxScore: 10,\n    justification: \'Demonstrated elite command of scalable design systems, multi-modal interface architectures, and WCAG AAA compliance standards.\',\n    trend: \'Top 3% of cohort\',\n  },\n  {\n    name: \'Problem Solving\',\n    score: 9.3,\n    maxScore: 10,\n    justification: \'Utilized empirical usability recordings rather than ideological debate to solve high-pressure engineering misalignment within 48 hours.\',\n    trend: \'Top 5% of cohort\',\n  },\n  {\n    name: \'Leadership\',\n    score: 9.5,\n    maxScore: 10,\n    justification: \'Established asynchronous visual documentation hubs and silent collaboration workflows that improved cross-team velocity by 28%.\',\n    trend: \'Top 4% of cohort\',\n  },\n  {\n    name: \'Clarity of Thought\',\n    score: 9.2,\n    maxScore: 10,\n    justification: \'Rigorous STAR-framework responses with concise contextual framing, precise spatial sign taxonomy, and quantified operational outcomes.\',\n    trend: \'Top 8% of cohort\',\n  },\n];\n\nexport const INTERVIEW_QUESTIONS: QuestionData[] = [\n  {\n    id: 1,\n    numberText: \'Question 1 of 3\',\n    question: \'Tell us about a complex project you led and how you handled team communication.\',\n    context: \'Focus on project scope, cross-functional collaboration, and communication strategies.\',\n    suggestedDurationSec: 32,\n    glossSequence: [\n      { timeMs: 1200, token: \'[PAST]\', meaning: \'Previous timeframe / context\', confidence: 0.99 },\n      { timeMs: 4000, token: \'[PROJECT-COMPLEX]\', meaning: \'Multi-team initiative\', confidence: 0.98 },\n      { timeMs: 7200, token: \'[ME-LEAD]\', meaning: \'I directed & owned\', confidence: 0.99 },\n      { timeMs: 11000, token: \'[FOUR-TEAM-CROSS]\', meaning: \'4 cross-functional teams\', confidence: 0.97 },\n      { timeMs: 15200, token: \'[COMMUNICATION-FRICTION]\', meaning: \'Spoken sync bottlenecks\', confidence: 0.96 },\n      { timeMs: 19500, token: \'[MAKE-VISUAL-BOARD]\', meaning: \'Created async visual hub\', confidence: 0.98 },\n      { timeMs: 23800, token: \'[DAILY-SYNC-SILENT]\', meaning: \'Daily silent standups\', confidence: 0.97 },\n      { timeMs: 28000, token: \'[DELIVER-EARLY]\', meaning: \'Delivered 2 weeks early\', confidence: 0.99 },\n      { timeMs: 31000, token: \'[SUCCESS]\', meaning: \'Zero regression launch\', confidence: 0.99 },\n    ],\n    sampleEnglishTranscript:\n      \'In my previous role, I directed the complete overhaul of our core enterprise design system across four cross-functional product teams. Because standard spoken meetings often created information silos and fatigue, I instituted a visual-first documentation board paired with daily asynchronous Slack standups. This visual taxonomy kept engineers and product managers tightly aligned, eliminating specification ambiguities and enabling us to ship the entire release two weeks ahead of schedule with zero accessibility regressions.\',\n    aiJudgmentNote:\n      \'Candidate articulated high-level strategic ownership using textbook STAR structure. Proactively converted potential communication barriers into an asynchronous visual system that benefited the entire cross-functional team, delivering the project 2 weeks ahead of target.\',\n    competencyHighlights: [\'Leadership\', \'Asynchronous Systems\', \'Technical Execution\'],\n    sampleGestures: [\n      { startMs: 0, endMs: 3500, primaryHand: \'both\', handshape: \'flatB\', motion: \'chestSweep\' },\n      { startMs: 3500, endMs: 8000, primaryHand: \'right\', handshape: \'pointing\', motion: \'forwardPush\' },\n      { startMs: 8000, endMs: 14000, primaryHand: \'both\', handshape: \'open5\', motion: \'circular\' },\n      { startMs: 14000, endMs: 21000, primaryHand: \'left\', handshape: \'vShape\', motion: \'horizontalWave\' },\n      { startMs: 21000, endMs: 27000, primaryHand: \'both\', handshape: \'flatB\', motion: \'forwardPush\' },\n      { startMs: 27000, endMs: 32000, primaryHand: \'right\', handshape: \'open5\', motion: \'nodding\' },\n    ],\n  },\n  {\n    id: 2,\n    numberText: \'Question 2 of 3\',\n    question: \'Describe a time you had to resolve a conflict or misalignment under a tight deadline.\',\n    context: \'Focus on stakeholder management, empathy under pressure, and conflict resolution.\',\n    suggestedDurationSec: 30,\n    glossSequence: [\n      { timeMs: 1200, token: \'[LAST-YEAR]\', meaning: \'During Q3 launch cycle\', confidence: 0.98 },\n      { timeMs: 4200, token: \'[DEADLINE-TIGHT-48HR]\', meaning: \'48hr code freeze pressure\', confidence: 0.99 },\n      { timeMs: 8000, token: \'[ENGINEER-DESIGN-CONFLICT]\', meaning: \'Disagreement on contrast\', confidence: 0.97 },\n      { timeMs: 12400, token: \'[ACCESSIBILITY-WCAG]\', meaning: \'Non-negotiable AAA rating\', confidence: 0.98 },\n      { timeMs: 16800, token: \'[CALL-EMERGENCY-LAB]\', meaning: \'Convened joint workshop\', confidence: 0.96 },\n      { timeMs: 21000, token: \'[SHOW-USER-DATA]\', meaning: \'Presented usability test tapes\', confidence: 0.99 },\n      { timeMs: 25200, token: \'[NEW-PALETTE-AGREE]\', meaning: \'Co-created hybrid token\', confidence: 0.98 },\n      { timeMs: 29000, token: \'[SHIP-ON-TIME]\', meaning: \'Shipped compliant on schedule\', confidence: 0.99 },\n    ],\n    sampleEnglishTranscript:\n      \'During our major Q3 release, our design and front-end engineering teams reached a sharp standoff over accessibility contrast tokens just 48 hours prior to code freeze. Rather than escalating up executive lines, I convened an immediate hands-on co-design workshop where I shared screen recordings of users with low vision failing the checkout flow with our initial colors. Grounding the dispute in user data depersonalized the conflict; we co-crafted a dual-layer token set that preserved the marketing aesthetics while securing full WCAG AAA compliance, deploying on time without friction.\',\n    aiJudgmentNote:\n      \'Demonstrated high emotional intelligence and consensus building. Defused an impending launch delay by replacing subjective debate with empirical user evidence, protecting both brand fidelity and non-negotiable accessibility.\',\n    competencyHighlights: [\'Conflict Resolution\', \'Data-Driven Advocacy\', \'Deadline Discipline\'],\n    sampleGestures: [\n      { startMs: 0, endMs: 4000, primaryHand: \'both\', handshape: \'pointing\', motion: \'horizontalWave\' },\n      { startMs: 4000, endMs: 9000, primaryHand: \'right\', handshape: \'fist\', motion: \'forwardPush\' },\n      { startMs: 9000, endMs: 16000, primaryHand: \'both\', handshape: \'flatB\', motion: \'chestSweep\' },\n      { startMs: 16000, endMs: 23000, primaryHand: \'left\', handshape: \'open5\', motion: \'circular\' },\n      { startMs: 23000, endMs: 30000, primaryHand: \'both\', handshape: \'flatB\', motion: \'nodding\' },\n    ],\n  },\n  {\n    id: 3,\n    numberText: \'Question 3 of 3\',\n    question: \'Why are you excited about this role, and what unique perspective do you bring?\',\n    context: \'Focus on mission alignment, lived experience, and technical contribution.\',\n    suggestedDurationSec: 28,\n    glossSequence: [\n      { timeMs: 1100, token: \'[EXCITED-DEEP]\', meaning: \'Genuinely energized\', confidence: 0.99 },\n      { timeMs: 4500, token: \'[COMPANY-MISSION]\', meaning: \'Universal product access\', confidence: 0.98 },\n      { timeMs: 8800, token: \'[MY-PERSPECTIVE-DEAF]\', meaning: \'Lived deaf experience\', confidence: 0.99 },\n      { timeMs: 13200, token: \'[NOT-CHECKLIST-MINDSET]\', meaning: \'Inclusion as core DNA\', confidence: 0.97 },\n      { timeMs: 17800, token: \'[MULTIMODAL-EXPERTISE]\', meaning: \'Gesture & spatial UI mastery\', confidence: 0.98 },\n      { timeMs: 22400, token: \'[BUILD-FOR-EVERYONE]\', meaning: \'Universal usability impact\', confidence: 0.99 },\n      { timeMs: 27000, token: \'[READY-CONTRIBUTE]\', meaning: \'Eager to drive innovation\', confidence: 0.99 },\n    ],\n    sampleEnglishTranscript:\n      \'I have dedicated my career to universal interface architecture because accessibility is not an edge-case checklist for me\342\200\224it is how I navigate every digital touchpoint in my daily life as a Deaf designer. I bring seven years of expertise in gesture-driven UX, spatial design, and sensory-balanced design systems. I am excited about this role because your product vision treats inclusive design not as a compliance afterthought, but as the primary engine of breakthrough user experiences.\',\n    aiJudgmentNote:\n      \'Exceptional alignment with role philosophy. Articulates how lived experience uniquely strengthens product architecture and multi-modal interaction design. Conveys unwavering passion with concrete value delivery.\',\n    competencyHighlights: [\'Universal Design Vision\', \'Multimodal Systems\', \'Lived Experience\'],\n    sampleGestures: [\n      { startMs: 0, endMs: 4000, primaryHand: \'right\', handshape: \'flatB\', motion: \'chestSweep\' },\n      { startMs: 4000, endMs: 9000, primaryHand: \'both\', handshape: \'open5\', motion: \'forwardPush\' },\n      { startMs: 9000, endMs: 16000, primaryHand: \'left\', handshape: \'pointing\', motion: \'nodding\' },\n      { startMs: 16000, endMs: 22000, primaryHand: \'both\', handshape: \'flatB\', motion: \'circular\' },\n      { startMs: 22000, endMs: 28000, primaryHand: \'both\', handshape: \'open5\', motion: \'chestSweep\' },\n    ],\n  },\n];\n"
        path {
          absolute_uri: "file:///src/data/interviewData.ts"
        }
        overwrite: true
      }
    }
