              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.ellipse(hx, hy + 12, 13, 6, 0, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
