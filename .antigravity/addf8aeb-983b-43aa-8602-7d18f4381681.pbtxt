              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const browSlant = isBrowFurrowed ? 3 : isBrowRaised ? -1 : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
