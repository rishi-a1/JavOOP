            }
            lines {
              text: "  // Hair (Professional modern neat crop)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.fillStyle = \'#0f172a\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
