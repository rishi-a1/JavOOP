              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.fillStyle = isActive ? color : \'rgba(148, 163, 184, 0.5)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx.textAlign = \'center\';"
