            }
            lines {
              text: "  // 4. Non-Manual Grammatical Markers (Brows & Eyes)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isBrowRaised = activeGloss.nmm.eyebrows === \'raised\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isBrowFurrowed = activeGloss.nmm.eyebrows === \'furrowed\';"
