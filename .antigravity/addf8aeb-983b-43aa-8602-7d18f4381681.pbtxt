            lines {
              text: "function drawSpatialLociHUD("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ctx: CanvasRenderingContext2D,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  width: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  height: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  activeGloss: GlossToken"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ") {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isLeftActive = activeGloss.spatialLocus.toLowerCase().includes(\'left\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isRightActive = activeGloss.spatialLocus.toLowerCase().includes(\'right\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const isCenterActive = !isLeftActive && !isRightActive;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Locus A: Left Spatial Anchor (e.g. Engineering)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const leftX = width * 0.16;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const leftY = height * 0.48;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  drawLocusNode(ctx, leftX, leftY, \'LOCUS A [ENGINEERING / PREVIOUS]\', isLeftActive, \'#38bdf8\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Locus B: Right Spatial Anchor (e.g. Design / Product)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const rightX = width * 0.84;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const rightY = height * 0.48;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  drawLocusNode(ctx, rightX, rightY, \'LOCUS B [DESIGN / VISION]\', isRightActive, \'#2dd4bf\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Center Spatial Envelope: Common Workplane"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cx = width * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cy = height * 0.58;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  drawLocusNode(ctx, cx, cy, \'CENTER SIGN VOLUME [SYNTHESIS]\', isCenterActive, \'#a78bfa\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Draw connecting 3D spatial indexing arc between loci if conflict or multi-team question"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (activeGloss.token.includes(\'DISAGREE\') || activeGloss.token.includes(\'TEAM FOUR\') || activeGloss.token.includes(\'BARRIER\')) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.save();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.strokeStyle = \'rgba(56, 189, 248, 0.4)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.lineWidth = 1.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.setLineDash([4, 4]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.moveTo(leftX, leftY);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.quadraticCurveTo(cx, cy - 80, rightX, rightY);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.stroke();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
