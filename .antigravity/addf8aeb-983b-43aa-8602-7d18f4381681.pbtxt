    content: "            <span className=\"text-slate-500\">NMM:</span>\n            <span className=\"text-teal-400 font-semibold\">\n              Brow: {activeGloss.nmm.eyebrows} \302\267 Head: {activeGloss.nmm.head} \302\267 Morpheme: &ldquo;{activeGloss.nmm.mouthMorpheme}&rdquo;\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n/* --- Realism Rendering Engines --- */\n\nfunction drawStudioEnvironment(ctx: CanvasRenderingContext2D, width: number, height: number) {\n  // Rich cinematic studio with subtle acoustics baffles backdrop\n  const bgGrad = ctx.createLinearGradient(0, 0, 0, height);\n  bgGrad.addColorStop(0, \'#070b14\');\n  bgGrad.addColorStop(0.5, \'#0f172a\');\n  bgGrad.addColorStop(1, \'#050810\');\n  ctx.fillStyle = bgGrad;\n  ctx.fillRect(0, 0, width, height);\n\n  // Soft directional key light from top-left (creates crisp contrast for hand articulators)\n  const keyLight = ctx.createRadialGradient(width * 0.35, height * 0.25, 40, width * 0.5, height * 0.4, width * 0.65);\n  keyLight.addColorStop(0, \'rgba(45, 212, 191, 0.09)\');\n  keyLight.addColorStop(0.6, \'rgba(56, 189, 248, 0.04)\');\n  keyLight.addColorStop(1, \'transparent\');\n  ctx.fillStyle = keyLight;\n  ctx.fillRect(0, 0, width, height);\n\n  // Subtle acoustic wall panel vertical ribbing in studio\n  ctx.fillStyle = \'rgba(255, 255, 255, 0.015)\';\n  for (let x = 30; x < width; x += 36) {\n    ctx.fillRect(x, 0, 18, height);\n  }\n}"
    num_lines: 1025
    num_bytes: 33175
  }
}
